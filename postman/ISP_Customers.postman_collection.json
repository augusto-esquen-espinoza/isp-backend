{
  "info": {
    "_postman_id": "e6f0f3d1-2c1a-4b6e-9f3a-isp-customers",
    "name": "ISP Customers API",
    "description": "Collection for the ISP Customers microservice. It covers both resources:\n\n1. Customers: creation and lookup (by dni, by email or without filters).\n2. Indicators: birth indicators aggregated by month/year.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains the created customer id', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.be.a('number');",
                  "});",
                  "const body = pm.response.json();",
                  "if (body && body.id) {",
                  "    pm.collectionVariables.set('customerId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Augusto\",\n  \"apellido\": \"Esquen\",\n  \"email\": \"augusto.esquen@example.com\",\n  \"dni\": \"12345678\",\n  \"fechaNacimiento\": \"1995-05-20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ]
            },
            "description": "Registers a new customer. The creation date is generated by the server."
          }
        },
        {
          "name": "Get all customers (no filters)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ]
            },
            "description": "Returns every registered customer, newest first."
          }
        },
        {
          "name": "Get customers by dni",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers?dni=12345678",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ],
              "query": [
                {
                  "key": "dni",
                  "value": "12345678"
                }
              ]
            },
            "description": "Returns the customer matching the given dni."
          }
        },
        {
          "name": "Get customers by email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers?email=augusto.esquen@example.com",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "augusto.esquen@example.com"
                }
              ]
            },
            "description": "Returns the customer matching the given email."
          }
        }
      ]
    },
    {
      "name": "Indicators",
      "item": [
        {
          "name": "Get birth indicators",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains the birth indicators', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('birthsByMonthYear');",
                  "    pm.expect(body).to.have.property('peakMonthYear');",
                  "    pm.expect(body).to.have.property('lowestMonthYear');",
                  "    pm.expect(body).to.have.property('birthRateByMonth');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/indicators",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "indicators"
              ]
            },
            "description": "Returns every birth indicator: births per month/year, the peak month/year, the lowest month/year and the birth rate of each month."
          }
        }
      ]
    }
  ]
}
